# Copy to apps/api/.env — values aligned with roadmap.md (never commit secrets).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanmesh?schema=public"
PORT=3001
NODE_ENV=development

# Citizen PWA + county dashboard origins
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Clustering — roadmap Wk 6 / key risk: keep configurable for corridor density
# Default: ≥3 same-category citizen reports within 15 m → auto-verify
CLUSTER_RADIUS_METERS=15
CLUSTER_THRESHOLD=3

# Phase 1 — photo upload storage (harden reporting API)
PHOTO_STORAGE_PATH="./storage/photos"
PHOTO_PUBLIC_BASE_URL=""

# Phase 1 — spam / duplicate report rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REPORTS=10

# Phase 2 — LPDP Policy Report PDF output (Wk 8)
LPDP_STORAGE_DIR="./storage/lpdp"
